<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Devity.Extensions" Version="2026.1.4.1450" />
    <PackageReference Include="Devity.Mailing" Version="2025.8.13.2012" />
    <PackageReference Include="Microsoft.AspNetCore.Components" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="9.0.22" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="9.0.22" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client.Core" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.22">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="9.0.22">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.14" />
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="9.0.0" />
  </ItemGroup>

  <!-- Security pins for transitive packages. Remove each one once the package that pulls it in ships a patched version.
       Devity.Mailing 2025.8.13.2012 depends on Devity.NETCore.MailKit 2.2.2, which brings in MailKit 4.11.0
       (GHSA-9j88-vvj5-vhgr), MimeKit 4.11.0 (GHSA-g7hc-96xr-gvvx) and System.Security.Cryptography.Pkcs 8.0.1
       (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7). Devity.NETCore.MailKit 2.5.1 depends on MailKit 4.18.2, which brings
       MimeKit 4.18.2 and Pkcs 10.0.13, so nothing but this one reference is needed. Drop it once Devity.Mailing depends
       on Devity.NETCore.MailKit 2.5.1 or newer. -->
  <ItemGroup>
    <PackageReference Include="Devity.NETCore.MailKit" Version="2.5.1" />
  </ItemGroup>

  <!-- Pomelo.EntityFrameworkCore.MySql 9.0.0 depends on MySqlConnector 2.4.0 (GHSA-473q-m89c-ghf8). Fixed in 2.6.1. -->
  <ItemGroup>
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ticky.Base\Ticky.Base.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Migrations\" />
  </ItemGroup>

</Project>
