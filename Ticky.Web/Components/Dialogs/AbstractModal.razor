@implements IDisposable

@code {
    [CascadingParameter(Name = Constants.CascadingParameters.MainLayout)]
    protected MainLayout MainLayout { get; set; } = default!;

    protected object? FocusElement { get; set; }

    protected Modal? Modal;

    public virtual async void Open() => await ShowAsync();

    /// <summary>Shows the modal and focuses <see cref="FocusElement"/>. Unlike <see cref="Open"/>, it can be awaited.</summary>
    protected async Task ShowAsync()
    {
        if (Modal is null)
            return;

        OnOpen();
        await Modal.Show();

        ElementReference? element = null;

        if (FocusElement is InputText inputText)
            element = inputText.Element.GetValueOrDefault();
        else if (FocusElement is InputTextArea inputTextArea)
            element = inputTextArea.Element.GetValueOrDefault();
        else if (FocusElement is ElementReference elementReference)
            element = elementReference;

        if(element.HasValue)
            await element.Value.FocusAsync();
    }

    protected virtual void OnOpen()
    {

    }

    /// <summary>
    /// Whether a change the dialog made through a service went through. If it didn't, tells the user why. When it was
    /// refused for access (the role may have changed since the dialog opened), the dialog closes too, since nothing in
    /// the form can fix that; an invalid value keeps it open to correct.
    /// </summary>
    protected Task<bool> SucceededAsync(IOperationResult result) =>
        MainLayout.ReportOrCloseAsync(result, () => Modal?.Close() ?? Task.CompletedTask);

    public virtual void Dispose()
    {

    }
}
