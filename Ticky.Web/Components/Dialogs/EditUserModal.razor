@inherits AbstractModal
@inject IDbContextFactory<DataContext> _dbContextFactory
@inject UserAccountService _userAccountService

<Modal @ref=Modal Title="Edit user" SubmitButtonText="Save" OnSubmitAttempted="EditUser">
    @if (_editContext is not null)
    {
        <EditForm class="form" EditContext="_editContext">
            <DataAnnotationsValidator />

            <div class="form-group">
                <Name For="() => _model.DisplayName" />
                <InputText class="input-field" placeholder="John Doe" autocomplete="off" @bind-Value="_model.DisplayName" @ref=FocusElement />
                <ValidationMessage For="() => _model.DisplayName" />
            </div>

            <div class="form-group">
                <Name For="() => _model.Email" />
                <InputText type="email" class="input-field" autocomplete="off" autocapitalize="off" spellcheck="false" @bind-Value="_model.Email" placeholder="sample@email.com" />
                <ValidationMessage For="() => _model.Email" />
                <p class="subtext ml-1 text-xs">@(_isSelf ? "You sign" : "They sign") in with this address.</p>
            </div>

            <HorizontalSeparator />

            <div class="form-section">
                <span class="form-label-category">Password</span>
                @if (_isSelf)
                {
                    <p class="subtext text-sm">
                        Change your own password in <a class="form-link underline" href="/settings/3">your settings</a>, where your current password is checked.
                    </p>
                }
                else if (_needsNewCredentials)
                {
                    <p class="subtext text-sm">They still have to choose their own password when they next sign in. Leave this empty to keep the one they have now.</p>
                }
                else
                {
                    <p class="subtext text-sm">Leave this empty to keep their current password.</p>
                }
            </div>

            @if (!_isSelf)
            {
                <div class="form-group">
                    <Name For="() => _model.NewPassword" />
                    <InputText type="password" class="input-field" autocomplete="new-password" autocapitalize="off" spellcheck="false" @bind-Value="_model.NewPassword" placeholder="Leave empty to keep it" />
                    <ValidationMessage For="() => _model.NewPassword" />
                </div>

                <div class="form-group">
                    <Name For="() => _model.ConfirmNewPassword" />
                    <InputText type="password" class="input-field" autocomplete="new-password" autocapitalize="off" spellcheck="false" @bind-Value="_model.ConfirmNewPassword" placeholder="Repeat new password" />
                    <ValidationMessage For="() => _model.ConfirmNewPassword" />
                </div>

                <div class="form-group">
                    <div class="flex flex-row items-center space-x-2">
                        <InputCheckbox class="toggle" id="edit-user-require-change" @bind-Value="_model.RequirePasswordChange" />
                        <label class="form-label" for="edit-user-require-change">Ask them to choose their own password when they next sign in</label>
                    </div>
                    <p class="subtext ml-1 text-xs">Only applies when you set a new password.</p>
                </div>
            }

            @if (_generalError is not null)
            {
                <p class="validation-message">@_generalError</p>
            }
        </EditForm>
    }
</Modal>

@code {
    [CascadingParameter(Name = Constants.CascadingParameters.CurrentAccount)]
    private User _user { get; set; } = default!;

    [CascadingParameter(Name = Constants.CascadingParameters.MainLayout)]
    private MainLayout MainLayout { get; set; } = default!;

    /// <summary>Runs after a save that changed something.</summary>
    [Parameter]
    public EventCallback OnSubmit { get; set; }

    private int _targetUserId;
    private bool _isSelf;
    private bool _needsNewCredentials;
    private bool _isSaving;
    private string? _generalError;
    private EditUserModel _model = new();
    private EditContext? _editContext;
    private ValidationMessageStore? _serverErrors;

    public async Task Open(int userId)
    {
        using var db = _dbContextFactory.CreateDbContext();
        var target = await db.Users.AsNoTracking().FirstOrDefaultAsync(x => x.Id == userId);

        if (target is null)
        {
            MainLayout.RunNotification(new("This user no longer exists.", NotificationType.Fail));
            return;
        }

        _targetUserId = target.Id;
        _isSelf = target.Id == _user.Id;
        _needsNewCredentials = target.NeedsNewCredentials;
        _generalError = null;
        _model = new() { DisplayName = target.DisplayName, Email = target.Email ?? string.Empty };
        _editContext = new EditContext(_model);
        _serverErrors = _editContext.CreateServerErrorStore();

        await ShowAsync();
    }

    private async Task EditUser()
    {
        if (_isSaving || _editContext is null || _serverErrors is null)
            return;

        _generalError = null;

        if (!_editContext.Validate())
            return;

        _isSaving = true;

        try
        {
            var result = await _userAccountService.UpdateUserAsync(
                _user.Id,
                _targetUserId,
                _model.DisplayName,
                _model.Email,
                _isSelf ? null : _model.NewPassword,
                _model.RequirePasswordChange);

            if (!result.Succeeded)
            {
                _generalError = result.ShowOn(_editContext, _serverErrors,
                    (UserAccountField.DisplayName, nameof(EditUserModel.DisplayName)),
                    (UserAccountField.Email, nameof(EditUserModel.Email)),
                    (UserAccountField.NewPassword, nameof(EditUserModel.NewPassword)));
                return;
            }

            if (result.AnythingChanged)
            {
                // The name and avatar in the menu come from the signed-in user, which was loaded before this change.
                if (_isSelf)
                    await MainLayout.RefreshUserAsync();

                await OnSubmit.InvokeAsync();
            }

            await Modal!.Close();
        }
        finally
        {
            _isSaving = false;
        }
    }
}
