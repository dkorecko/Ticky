@inject IDbContextFactory<DataContext> _dbContextFactory
@inject ILogger<CloneBoardModal> _logger
@inject BoardService _boardService
@inherits AbstractModal

<Modal @ref="Modal" Title="Clone board" OnSubmitAttempted="OnSubmitAttempted">
	<EditForm class="form" EditContext="_editContext">
		<DataAnnotationsValidator />

		<div class="form-group">
			<Name For="() => _model.TargetProjectId" />
			<InputSelect class="input-field" @bind-Value="_model.TargetProjectId">
				<option value="">Select project...</option>
				@foreach (var project in _projects)
				{
					<option value="@project.Id">@project.Name</option>
				}
			</InputSelect>
			<ValidationMessage For="() => _model.TargetProjectId" />
			@if (_projects.Count == 0)
			{
				<p class="subtext">You don't administer any project, so there's nowhere to clone this board to.</p>
			}
		</div>

		<div class="form-group">
			<Name For="() => _model.Code" />
			<InputText class="input-field" @bind-Value="_model.Code" placeholder="e.g. TCK" />
			<ValidationMessage For="() => _model.Code" />
		</div>
	</EditForm>
</Modal>

@code {
	[CascadingParameter(Name = Constants.CascadingParameters.CurrentAccount)]
	private User _user { get; set; } = default!;

	[Parameter]
	public EventCallback OnCloned { get; set; }

	private Board? _sourceBoard;
	private List<Project> _projects = [];

	private CloneBoardModel _model = new();
	private EditContext? _editContext;

	public async Task Open(Board sourceBoard)
	{
		_sourceBoard = sourceBoard;

		using var db = _dbContextFactory.CreateDbContext();

		// Only projects the user may add boards to, as with creating a board.
		_projects = await db.Projects
			.AsNoTracking()
			.Where(Project.AdministeredBy(_user.Id))
			.OrderBy(x => x.Name)
			.ToListAsync();

		_model = new CloneBoardModel
		{
			TargetProjectId = _projects.Any(x => x.Id == sourceBoard.ProjectId) ? sourceBoard.ProjectId : null,
			Code = sourceBoard.Code,
		};
		_editContext = new(_model);

		base.Open();
	}

	private async Task OnSubmitAttempted()
	{
		if (Modal is null || _editContext is null)
			return;

		if (!_editContext.Validate())
			return;

		await OnValidSubmit();
	}

	private async Task OnValidSubmit()
	{
		if (_sourceBoard is null || Modal is null)
			return;

		var result = await _logger.TrySaveAsync(
			() => _boardService.CloneAsync(_sourceBoard.Id, _user.Id, _model.TargetProjectId!.Value, _model.Code),
			"Failed to clone the board. Please try again."
		);

		if (!await SucceededAsync(result))
			return;

		MainLayout.RunNotification(new("Board cloned successfully.", NotificationType.Success));
		await OnCloned.InvokeAsync();
		await Modal.Close();
	}
}
