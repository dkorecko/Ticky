@inherits AbstractModal
@inject UserAccountService _userAccountService

<Modal @ref=Modal Title="Add user" SubmitButtonText="Create" OnSubmitAttempted="AddUser">
    @if (_editContext is not null)
    {
        <EditForm class="form" EditContext="_editContext">
            <DataAnnotationsValidator />

            <div class="form-group">
                <Name For="() => _userModel.DisplayName" />
                <InputText class="input-field" placeholder="John Doe" autocomplete="off" @bind-Value="_userModel.DisplayName" @ref=FocusElement />
                <ValidationMessage For="() => _userModel.DisplayName" />
            </div>

            <div class="form-group">
                <Name For="() => _userModel.Email" />
                <InputText type="email" class="input-field" autocomplete="off" autocapitalize="off" spellcheck="false" @bind-Value="_userModel.Email" placeholder="sample@email.com" />
                <ValidationMessage For="() => _userModel.Email" />
            </div>

            <div class="form-group">
                <Name For="() => _userModel.Password" />
                <InputText type="password" class="input-field" autocomplete="new-password" autocapitalize="off" spellcheck="false" @bind-Value="_userModel.Password" placeholder="Password" />
                <ValidationMessage For="() => _userModel.Password" />
                <p class="subtext ml-1 text-xs">They will have to choose their own password when they first sign in.</p>
            </div>

            <div class="form-group">
                <Name For="() => _userModel.ConfirmPassword" />
                <InputText type="password" class="input-field" autocomplete="new-password" autocapitalize="off" spellcheck="false" @bind-Value="_userModel.ConfirmPassword" placeholder="Repeat password" />
                <ValidationMessage For="() => _userModel.ConfirmPassword" />
            </div>

            @if (_generalError is not null)
            {
                <p class="validation-message">@_generalError</p>
            }
        </EditForm>
    }
</Modal>

@code {
    [CascadingParameter(Name = Constants.CascadingParameters.CurrentAccount)]
    private User _user { get; set; } = default!;

    [Parameter]
    public EventCallback OnSubmit { get; set; }

    private bool _isSaving;
    private string? _generalError;
    private UserModel _userModel = new();
    private EditContext? _editContext;
    private ValidationMessageStore? _serverErrors;

    public override void Open()
    {
        _userModel = new();
        _generalError = null;
        _editContext = new EditContext(_userModel);
        _serverErrors = _editContext.CreateServerErrorStore();

        base.Open();
    }

    private async Task AddUser()
    {
        if (_isSaving || _editContext is null || _serverErrors is null)
            return;

        _generalError = null;

        if (!_editContext.Validate())
            return;

        _isSaving = true;

        try
        {
            var result = await _userAccountService.CreateUserAsync(_user.Id, _userModel.DisplayName, _userModel.Email, _userModel.Password);

            if (!result.Succeeded)
            {
                _generalError = result.ShowOn(_editContext, _serverErrors,
                    (UserAccountField.DisplayName, nameof(UserModel.DisplayName)),
                    (UserAccountField.Email, nameof(UserModel.Email)),
                    (UserAccountField.NewPassword, nameof(UserModel.Password)));
                return;
            }

            await OnSubmit.InvokeAsync();
            await Modal!.Close();
        }
        finally
        {
            _isSaving = false;
        }
    }
}
