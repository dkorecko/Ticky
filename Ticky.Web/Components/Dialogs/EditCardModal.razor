            }

            return;
        }

        _ongoingTimer = DateTime.Now - targetRecord.StartedAt;
        StateHasChanged();
        
        if (_timer is not null)
        {
            _timer.Stop();
            _timer.Dispose();
        }

        _timer = new System.Timers.Timer(1000);
        _timer.Elapsed += OnTimerTick;
        _timer.AutoReset = true;
        _timer.Start();
    }

