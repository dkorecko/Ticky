@page "/settings/{Tab:int?}"
@using System.Reflection
@inject IDbContextFactory<DataContext> _dbContextFactory
@inject ILogger<UserSettings> _logger
@inject AvatarService _avatarService
@inject UserAccountService _userAccountService
@inject NavigationManager _navigationManager
@inherits NotifiableBase

<PageTitle>Settings - @Constants.APP_NAME</PageTitle>

<div class="island flex flex-col space-y-6">
    <h2 class="">
        User settings
    </h2>

    <section class="settings-menu">
        <div data-active='@(_tab == 1 ? "true" : "false")' class="settings-menu-item @(_tab == 1 ? "selected" : "")" @onclick="() => GoToTab(1)">General</div>
        <div data-active='@(_tab == 2 ? "true" : "false")' class="settings-menu-item @(_tab == 2 ? "selected" : "")" @onclick="() => GoToTab(2)">Avatar</div>
        <div data-active='@(_tab == 3 ? "true" : "false")' class="settings-menu-item @(_tab == 3 ? "selected" : "")" @onclick="() => GoToTab(3)">Credentials</div>
    </section>

    @if (_user is null)
    {
        <Spinner />
    }
    else if (_tab == 1)
    {
        <div class="setting-description">
            <h6 class="font-semibold">General settings</h6>
            <p class="text-sm opacity-70">All the most important settings for your profile, which do not belong to any other categories.</p>
        </div>

        <HorizontalSeparator/>

        <div class="settings-section">
            <div class="setting-description">
                <label class="font-semibold opacity-90" for="settings-display-name">Display name</label>
                <label class="w-4/5 max-w-2xl opacity-70" for="settings-display-name">
                    The name other people see next to your cards, comments and activity.
                </label>
            </div>

            <EditForm class="form col-span-3 w-full max-w-sm md:col-span-1 lg:col-span-2" EditContext="_nameContext" OnValidSubmit="SaveDisplayName">
                <DataAnnotationsValidator />

                <div class="form-group">
                    <InputText id="settings-display-name" class="input-field" autocomplete="name" @bind-Value="_nameModel.DisplayName" placeholder="John Doe" />
                    <ValidationMessage For="() => _nameModel.DisplayName" />
                </div>

                @if (_nameError is not null)
                {
                    <p class="validation-message">@_nameError</p>
                }

                <button class="btn btn-purple max-w-sm" type="submit" disabled="@_isSaving">Save name</button>
            </EditForm>
        </div>

        <HorizontalSeparator />

        <div class="settings-section">
            <div class="setting-description">
                <label class="font-semibold opacity-90">Advanced card settings after creation</label>
                <label class="w-4/5 max-w-2xl opacity-70">
                    Changes, whether the large modal for setting up a card should open
                    after creating a card on the board.
                </label>
            </div>

            <div class="flex flex-row space-x-2">
                <input type="checkbox" class="toggle" checked=@_user.AutomaticCardEdit @onchange="(e) => OnSettingChanged(e, x => x.AutomaticCardEdit)">
            </div>
        </div>

        <HorizontalSeparator />

        <div class="settings-section">
            <div class="setting-description">
                <label class="font-semibold opacity-90">Delete without confirmation</label>
                <label class="w-4/5 max-w-2xl opacity-70">
                    This defines whether you should receive a confirmation pop-up whenever you
                    initiate a deletion of an object.
                </label>
            </div>

            <input type="checkbox" class="toggle" checked=@_user.InstantDelete @onchange="(e) => OnSettingChanged(e, x => x.InstantDelete)">
        </div>

        <HorizontalSeparator />

        <div class="settings-section">
            <div class="setting-description">
                <label class="font-semibold opacity-90">Automatic reminder on deadline</label>
                <label class="w-4/5 max-w-2xl opacity-70">
                    This option sets whether you will automatically be reminded about a card's deadline at the start of the day.
                </label>
            </div>

            <input type="checkbox" class="toggle" checked=@_user.AutomaticDeadlineReminder @onchange="(e) => OnSettingChanged(e, x => x.AutomaticDeadlineReminder)">
        </div>

        <HorizontalSeparator />

        <div class="settings-section">
            <div class="setting-description">
                <label class="font-semibold opacity-90">Automatically assign self</label>
                <label class="w-4/5 max-w-2xl opacity-70">
                    This option sets whether you will automatically assign yourself to created cards.
                </label>
            </div>

            <input type="checkbox" class="toggle" checked=@_user.AutomaticAssign @onchange="(e) => OnSettingChanged(e, x => x.AutomaticAssign)">
        </div>

        <HorizontalSeparator />

        <div class="settings-section">
            <div class="setting-description">
                <label class="font-semibold opacity-90">Card size</label>
                <label class="w-4/5 max-w-2xl opacity-70">
                    How large columns and cards are on boards. Compact fits more on the screen, large is easier to read.
                    It only changes how boards look for you.
                </label>
            </div>

            <div class="flex h-min w-max flex-row gap-1 rounded-button border border-line p-0.5" role="radiogroup" aria-label="Card size">
                @* Sorted again: GetValues orders by the unsigned value, which puts Compact (-1) last. *@
                @foreach (var size in Enum.GetValues<CardSize>().Order())
                {
                    <button type="button" role="radio" aria-checked="@((_user.CardSize == size).ToString().ToLowerInvariant())"
                            data-active="@((_user.CardSize == size).ToString())" class="detail-tab"
                            @onclick="() => SetCardSize(size)">
                        @size
                    </button>
                }
            </div>
        </div>
    }
    else if (_tab == 2)
    {
        <div class="setting-description">
            <h6 class="font-semibold">Avatar</h6>
            <p class="text-sm opacity-70">Here you can change your profile picture.</p>
        </div>

        <HorizontalSeparator />

        <div class="settings-section">
            <div class="setting-description">
                <label class="font-semibold opacity-90">Avatar image</label>
            </div>

            <div class="avatar-settings aspect-square max-h-8 max-w-8 rounded-full"
                 style="background-image: url('@Constants.ACCESS_UPLOADED_IMAGES_PATH/@_user.ProfilePictureFileName?v=@DateTime.Now.Ticks');" />
        </div>

        <HorizontalSeparator />

        <div class="settings-section">
            <div class="setting-description">
                <label class="font-semibold opacity-90">Rounded image</label>
            </div>

            <div class="avatar-settings aspect-square max-h-32 max-w-32 rounded-full"
                 style="background-image: url('@Constants.ACCESS_UPLOADED_IMAGES_PATH/@_user.ProfilePictureFileName?v=@DateTime.Now.Ticks');" />
        </div>

        <HorizontalSeparator />

        <div class="settings-section">
            <div class="setting-description">
                <label class="font-semibold opacity-90">Full image</label>
                <label class="w-4/5 max-w-2xl opacity-70">
                    Profile picture in a full size.
                </label>
            </div>

            <div class="rounded-island avatar-settings aspect-square max-h-60 max-w-60"
                 style="background-image: url('@Constants.ACCESS_UPLOADED_IMAGES_PATH/@_user.ProfilePictureFileName?v=@DateTime.Now.Ticks');" />
        </div>

        <HorizontalSeparator />

        <div class="">
            @if (_isLoading)
            {
                <Spinner />
            }

            <div class="flex flex-row gap-4">
                <label class="btn btn-yellow max-w-44" for="file-upload">Upload</label>
                <InputFile class="hidden" id="file-upload" OnChange="OnFileChanged" accept="@string.Join(',', Constants.Avatars.CONTENT_TYPES.Keys)" />
                <button class="btn btn-red max-w-44" @onclick="RestoreToOriginal">Reset</button>
            </div>
        </div>
    }
    else if (_tab == 3 && MustSetCredentials)
    {
        @* Keeps the user here until the credentials are set. Signing out stays possible. *@
        <NavigationLock ConfirmExternalNavigation=true OnBeforeInternalNavigation="OnBeforeInternalNavigation" />

        <div class="setting-description">
            <h6 class="font-semibold">Credentials</h6>
            <label class="warning">This account is either using default credentials or they have been set up by the administrator, therefore they must be changed before going any further.</label>
        </div>

        <HorizontalSeparator />

        <EditForm class="form max-w-sm" EditContext="_requiredContext" OnValidSubmit="SetRequiredCredentials">
            <DataAnnotationsValidator />

            <div class="form-group">
                <Name For="() => _requiredModel.Email" />
                <InputText type="email" class="input-field" autocomplete="username" autocapitalize="off" spellcheck="false" @bind-Value="_requiredModel.Email" placeholder="sample@email.com" />
                <ValidationMessage For="() => _requiredModel.Email" />
                <p class="subtext ml-1 text-xs">You sign in with this address. Keep it or change it now.</p>
            </div>

            <div class="form-group">
                <Name For="() => _requiredModel.NewPassword" />
                <InputText type="password" autocomplete="new-password" autocapitalize="off" spellcheck="false" class="input-field" @bind-Value="_requiredModel.NewPassword" placeholder="New password" autofocus />
                <ValidationMessage For="() => _requiredModel.NewPassword" />
            </div>

            <div class="form-group">
                <Name For="() => _requiredModel.ConfirmNewPassword" />
                <InputText type="password" autocomplete="new-password" autocapitalize="off" spellcheck="false" class="input-field" @bind-Value="_requiredModel.ConfirmNewPassword" placeholder="Repeat new password" />
                <ValidationMessage For="() => _requiredModel.ConfirmNewPassword" />
            </div>

            @if (_requiredError is not null)
            {
                <p class="validation-message">@_requiredError</p>
            }

            <p class="subtext text-sm">Afterwards, you sign in again with your new credentials.</p>

            <button class="btn btn-purple max-w-sm" type="submit" disabled="@_isSaving">Save and continue</button>
        </EditForm>
    }
    else if (_tab == 3)
    {
        <div class="setting-description">
            <h6 class="font-semibold">Credentials</h6>
            <p class="text-sm opacity-70">Change the email address you sign in with, or your password. Both ask for your current password.</p>
        </div>

        <HorizontalSeparator />

        <div class="settings-section">
            <div class="setting-description">
                <label class="font-semibold opacity-90">Email address</label>
                <label class="w-4/5 max-w-2xl break-words opacity-70">
                    You sign in with <b>@_user.Email</b>. You stay signed in after changing it.
                </label>
            </div>

            <EditForm class="form col-span-3 w-full max-w-sm md:col-span-1 lg:col-span-2" EditContext="_emailContext" OnValidSubmit="ChangeEmail">
                <DataAnnotationsValidator />

                <div class="form-group">
                    <Name For="() => _emailModel.NewEmail" />
                    <InputText type="email" class="input-field" autocomplete="email" autocapitalize="off" spellcheck="false" @bind-Value="_emailModel.NewEmail" placeholder="sample@email.com" />
                    <ValidationMessage For="() => _emailModel.NewEmail" />
                </div>

                <div class="form-group">
                    <Name For="() => _emailModel.CurrentPassword" />
                    <InputText type="password" class="input-field" autocomplete="current-password" autocapitalize="off" spellcheck="false" @bind-Value="_emailModel.CurrentPassword" placeholder="Current password" />
                    <ValidationMessage For="() => _emailModel.CurrentPassword" />
                </div>

                @if (_emailError is not null)
                {
                    <p class="validation-message">@_emailError</p>
                }

                <button class="btn btn-purple max-w-sm" type="submit" disabled="@_isSaving">Change email</button>
            </EditForm>
        </div>

        <HorizontalSeparator />

        <div class="settings-section">
            <div class="setting-description">
                <label class="font-semibold opacity-90">Password</label>
                <label class="w-4/5 max-w-2xl opacity-70">
                    Changing it signs you out everywhere, including here. Then you sign in with the new password.
                </label>
            </div>

            <EditForm class="form col-span-3 w-full max-w-sm md:col-span-1 lg:col-span-2" EditContext="_passwordContext" OnValidSubmit="ChangePassword">
                <DataAnnotationsValidator />

                @* Lets password managers tell which account the new password belongs to. *@
                <input type="email" autocomplete="username" value="@_user.Email" hidden readonly />

                <div class="form-group">
                    <Name For="() => _passwordModel.CurrentPassword" />
                    <InputText type="password" class="input-field" autocomplete="current-password" autocapitalize="off" spellcheck="false" @bind-Value="_passwordModel.CurrentPassword" placeholder="Current password" />
                    <ValidationMessage For="() => _passwordModel.CurrentPassword" />
                </div>

                <div class="form-group">
                    <Name For="() => _passwordModel.NewPassword" />
                    <InputText type="password" class="input-field" autocomplete="new-password" autocapitalize="off" spellcheck="false" @bind-Value="_passwordModel.NewPassword" placeholder="New password" />
                    <ValidationMessage For="() => _passwordModel.NewPassword" />
                </div>

                <div class="form-group">
                    <Name For="() => _passwordModel.ConfirmNewPassword" />
                    <InputText type="password" class="input-field" autocomplete="new-password" autocapitalize="off" spellcheck="false" @bind-Value="_passwordModel.ConfirmNewPassword" placeholder="Repeat new password" />
                    <ValidationMessage For="() => _passwordModel.ConfirmNewPassword" />
                </div>

                @if (_passwordError is not null)
                {
                    <p class="validation-message">@_passwordError</p>
                }

                <button class="btn btn-purple max-w-sm" type="submit" disabled="@_isSaving">Change password</button>
            </EditForm>
        </div>

        <HorizontalSeparator />

        <div class="settings-section">
            <div class="setting-description">
                <label class="font-semibold opacity-90">API tokens</label>
                <label class="w-4/5 max-w-2xl opacity-70">
                    Long-lived bearer tokens for programmatic access to Ticky. Mint, list and revoke them on a dedicated page.
                </label>
            </div>

            <a class="btn btn-purple flex max-w-sm !w-max items-center gap-1.5 col-span-3 md:col-span-1 lg:col-span-2" href="/settings/api-tokens">
                <span class="material-symbols-rounded g-icon self-center">key</span>
                <span class="self-center">Manage API tokens</span>
            </a>
        </div>
    }
</div>

@code {
    [CascadingParameter(Name = Constants.CascadingParameters.CurrentAccount)]
    private User? _user { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    [Parameter]
    public int? Tab { get; set; }

    private int _tab = 1;
    private int? _appliedTab;

    private IBrowserFile? _uploadedFile;

    private bool _isLoading;
    private bool _isSaving;

    /// <summary>Set once the required credentials are saved, so the page lets the user go while signing them out.</summary>
    private bool _credentialsSet;

    private DisplayNameModel _nameModel = new();
    private EditContext _nameContext = default!;
    private ValidationMessageStore _nameErrors = default!;
    private string? _nameError;

    private EmailChangeModel _emailModel = new();
    private EditContext _emailContext = default!;
    private ValidationMessageStore _emailErrors = default!;
    private string? _emailError;

    private PasswordChangeModel _passwordModel = new();
    private EditContext _passwordContext = default!;
    private ValidationMessageStore _passwordErrors = default!;
    private string? _passwordError;

    private RequiredCredentialsModel _requiredModel = new();
    private EditContext _requiredContext = default!;
    private ValidationMessageStore _requiredErrors = default!;
    private string? _requiredError;

    private bool MustSetCredentials => _user?.NeedsNewCredentials == true && !_credentialsSet;

    protected override void OnInitialized()
    {
        // MainLayout only shows pages once the signed-in user is loaded.
        ArgumentNullException.ThrowIfNull(_user);

        ResetNameForm(_user.DisplayName);
        ResetEmailForm();
        ResetPasswordForm();

        _requiredModel = new() { Email = _user.Email ?? string.Empty };
        _requiredContext = new EditContext(_requiredModel);
        _requiredErrors = _requiredContext.CreateServerErrorStore();
    }

    protected override void OnParametersSet()
    {
        if (MustSetCredentials)
        {
            _tab = 3;
            return;
        }

        // Only when the address changes: this also runs whenever the signed-in user is reloaded.
        if (Tab == _appliedTab)
            return;

        _appliedTab = Tab;

        if (Tab.HasValue)
            _tab = Math.Clamp(Tab.Value, 1, 3);
    }

    private void GoToTab(int tabNumber)
    {
        if (MustSetCredentials && tabNumber != 3)
        {
            OnAttemptedLeaveWhenDisallowed();
            return;
        }

        _tab = Math.Clamp(tabNumber, 1, 3);
    }

    private void ResetNameForm(string displayName)
    {
        _nameModel = new() { DisplayName = displayName };
        _nameContext = new EditContext(_nameModel);
        _nameErrors = _nameContext.CreateServerErrorStore();
    }

    private void ResetEmailForm()
    {
        _emailModel = new();
        _emailContext = new EditContext(_emailModel);
        _emailErrors = _emailContext.CreateServerErrorStore();
    }

    private void ResetPasswordForm()
    {
        _passwordModel = new();
        _passwordContext = new EditContext(_passwordModel);
        _passwordErrors = _passwordContext.CreateServerErrorStore();
    }

    private async Task SaveDisplayName()
    {
        if (_user is null || _isSaving)
            return;

        _nameError = null;
        _isSaving = true;

        try
        {
            var result = await _userAccountService.ChangeDisplayNameAsync(_user.Id, _nameModel.DisplayName);

            if (!result.Succeeded)
            {
                _nameError = result.ShowOn(_nameContext, _nameErrors,
                    (UserAccountField.DisplayName, nameof(DisplayNameModel.DisplayName)));
                return;
            }

            ResetNameForm(_nameModel.DisplayName.Trim());

            if (!result.DisplayNameChanged)
                return;

            await MainLayout.RefreshUserAsync();
            MainLayout.RunNotification(new("Your name was changed."));
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task ChangeEmail()
    {
        if (_user is null || _isSaving)
            return;

        _emailError = null;
        _isSaving = true;

        try
        {
            var result = await _userAccountService.ChangeEmailAsync(_user.Id, _emailModel.CurrentPassword, _emailModel.NewEmail);

            if (!result.Succeeded)
            {
                _emailError = result.ShowOn(_emailContext, _emailErrors,
                    (UserAccountField.Email, nameof(EmailChangeModel.NewEmail)),
                    (UserAccountField.CurrentPassword, nameof(EmailChangeModel.CurrentPassword)));
                return;
            }

            ResetEmailForm();
            await MainLayout.RefreshUserAsync();
            MainLayout.RunNotification(new("Your email address was changed. Use it the next time you sign in."));
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task ChangePassword()
    {
        if (_user is null || _isSaving)
            return;

        _passwordError = null;
        _isSaving = true;

        try
        {
            var result = await _userAccountService.ChangePasswordAsync(_user.Id, _passwordModel.CurrentPassword, _passwordModel.NewPassword);

            if (!result.Succeeded)
            {
                _passwordError = result.ShowOn(_passwordContext, _passwordErrors,
                    (UserAccountField.CurrentPassword, nameof(PasswordChangeModel.CurrentPassword)),
                    (UserAccountField.NewPassword, nameof(PasswordChangeModel.NewPassword)));
                return;
            }

            SignInAgain();
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task SetRequiredCredentials()
    {
        if (_user is null || _isSaving || AuthenticationStateTask is null)
            return;

        _requiredError = null;
        _isSaving = true;

        try
        {
            var session = (await AuthenticationStateTask).User;
            var result = await _userAccountService.SetRequiredCredentialsAsync(_user.Id, session, _requiredModel.Email, _requiredModel.NewPassword);

            if (result.Succeeded || result.SignInRequired)
            {
                SignInAgain();
                return;
            }

            _requiredError = result.ShowOn(_requiredContext, _requiredErrors,
                (UserAccountField.Email, nameof(RequiredCredentialsModel.Email)),
                (UserAccountField.NewPassword, nameof(RequiredCredentialsModel.NewPassword)));
        }
        finally
        {
            _isSaving = false;
        }
    }

    /// <summary>
    /// Signs the user out and sends them to sign in again. A new password renews the security stamp, so the sign-in
    /// cookie of this browser stops being valid too; Identity would otherwise sign them out at some point within half
    /// an hour.
    /// </summary>
    private void SignInAgain()
    {
        // Removes the navigation lock first, so the browser doesn't ask whether to leave the page.
        _credentialsSet = true;
        StateHasChanged();
        _navigationManager.NavigateTo($"{Constants.Mappings.LOGOUT_PATH}?passwordChanged=true", forceLoad: true);
    }

    private async void OnSettingChanged(ChangeEventArgs e, Expression<Func<User, bool>> setter)
    {
        ArgumentNullException.ThrowIfNull(_user);

        if (e.Value is not bool val)
            return;

        using var db = _dbContextFactory.CreateDbContext();

        var user = await db.Users.FirstOrDefaultAsync(x => x.Id.Equals(_user.Id));

        if (user is null)
            return;

        if (setter.Body is MemberExpression memberExpression && memberExpression.Member is PropertyInfo propertyInfo && propertyInfo.PropertyType == typeof(bool))
            propertyInfo.SetValue(user, val);
        else throw new Exception("Invalid property provided.");

        await db.SaveChangesAsync();

        await RunNotification(typeof(UserSettings), OperationType.Edited);
    }

    private async Task SetCardSize(CardSize size)
    {
        ArgumentNullException.ThrowIfNull(_user);

        if (_user.CardSize == size)
            return;

        using var db = _dbContextFactory.CreateDbContext();

        var user = await db.Users.FirstOrDefaultAsync(x => x.Id.Equals(_user.Id));

        if (user is null)
            return;

        user.CardSize = size;
        await db.SaveChangesAsync();

        // Boards read the size from the signed-in user, so reload it for them to pick the change up.
        await MainLayout.RefreshUserAsync();
        await RunNotification(typeof(UserSettings), OperationType.Edited);
    }

    private void ShowUploadError(string message)
    {
        _isLoading = false;
        MainLayout.RunNotification(new Notification($"File upload failed: {message}", NotificationType.Fail));
        StateHasChanged();
    }

    public async Task RestoreToOriginal()
    {
        ArgumentNullException.ThrowIfNull(_user);

        var avatarPath = await _avatarService.FetchAvatarAsync(_user.DisplayName);

        using var db = _dbContextFactory.CreateDbContext();
        var user = await db.Users.FirstOrDefaultAsync(x => x.Id.Equals(_user.Id));

        if (user is null)
            return;

        user.ProfilePictureFileName = avatarPath;
        await db.SaveChangesAsync();
        await MainLayout.RefreshUserAsync();

        MainLayout.RunNotification(new Notification("Profile picture was reset to the default one."));
    }

    public async Task OnFileChanged(InputFileChangeEventArgs e)
    {
        ArgumentNullException.ThrowIfNull(_user);
        _isLoading = true;

        // The browser-reported content type can be faked, so the stored extension is what decides how the file is served.
        if (!e.File.ContentType.Contains("image")
            || !Constants.Avatars.CONTENT_TYPES.ContainsKey(UploadHelper.GetSafeExtension(e.File.Name)))
        {
            ShowUploadError("The file must be a PNG, JPG, GIF, WebP or AVIF image.");
            return;
        }

        if (e.File.Size > Constants.Limits.MAX_IMAGE_SIZE)
        {
            ShowUploadError("The file is too large.");
            return;
        }

        try
        {
            _uploadedFile = e.File;
            var folderPath = Constants.SAVE_UPLOADED_IMAGES_PATH;

            if (!Directory.Exists(folderPath))
                Directory.CreateDirectory(folderPath);

            var trustedFileName = UploadHelper.CreateStoredFileName(folderPath, _uploadedFile.Name);
            var path = Path.Combine(folderPath, trustedFileName);

            await using FileStream fs = new(path, FileMode.Create);
            await e.File.OpenReadStream(Constants.Limits.MAX_IMAGE_SIZE).CopyToAsync(fs);

            using var db = _dbContextFactory.CreateDbContext();
            var user = await db.Users.FirstOrDefaultAsync(x => x.Id.Equals(_user.Id));

            if(user is null)
            {
                ShowUploadError("An error occured. Try again later.");
                return;
            }

            user.ProfilePictureFileName = trustedFileName;

            await db.SaveChangesAsync();
            await MainLayout.RefreshUserAsync();

            MainLayout.RunNotification(new Notification("Profile picture was changed."));
            _isLoading = false;
        }
        catch (Exception ex)
        {
            _logger.LogError($"File upload failed, file name {e.File.Name}, error: {ex}");
            ShowUploadError("An error occured. Try again later.");
        }

        StateHasChanged();
    }

    private void OnBeforeInternalNavigation(LocationChangingContext context)
    {
        if (!MustSetCredentials)
            return;

        if (("/" + _navigationManager.ToBaseRelativePath(context.TargetLocation)).StartsWith(Constants.Mappings.LOGOUT_PATH, StringComparison.OrdinalIgnoreCase))
            return;

        context.PreventNavigation();
        OnAttemptedLeaveWhenDisallowed();
    }

    private void OnAttemptedLeaveWhenDisallowed()
    {
        MainLayout.RunNotification(new("You can't leave this page until you have changed your credentials.", NotificationType.Fail));
    }
}
