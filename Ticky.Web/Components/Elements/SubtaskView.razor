@using Microsoft.JSInterop
@using Microsoft.EntityFrameworkCore
@inject CardService _cardService
@inject ILogger<SubtaskView> _logger

@inherits NotifiableBase

<div id="@Subtask.Id" class="group flex flex-row items-center gap-2 rounded-lg px-1.5 py-1 text-sm font-normal hover:bg-text/[0.04] dark:hover:bg-textDark/[0.05]">
    <span class="material-symbols-rounded drag-toggle cursor-move !text-lg leading-none text-subtext opacity-100 transition-opacity pointer-fine:opacity-0 pointer-fine:group-hover:opacity-100 pointer-fine:group-focus-within:opacity-100 dark:text-subtextDark" title="Drag to reorder subtask">drag_indicator</span>
    <input id="subtask_checkbox_@Subtask.Id" class="check" type="checkbox" checked="@Subtask.Completed" @onchange="OnSubtaskStatusChanged" />
    <label class='min-w-0 flex-1 break-words @(Subtask.Completed ? "text-subtext line-through dark:text-subtextDark" : "")' for="subtask_checkbox_@Subtask.Id">@Subtask.Text</label>

    @if (Subtask.Assignees.Any())
    {
        <div class="flex flex-row pl-2">
            @{
                var i = 0;
                foreach (var assignee in Subtask.Assignees.OrderBy(x => x.DisplayName))
                {
                    var avatarId = $"subtask_assignee_{Subtask.Id}_{i}";
                    <div id=@avatarId class="avatar-mini @(i > 0 ? "stack-avatars !-ml-2" : "") cursor-pointer" style="background-image: url('@Constants.ACCESS_UPLOADED_IMAGES_PATH/@assignee.ProfilePictureFileName');" @onclick="() => MainLayout.UserInfoModal?.Open(avatarId, assignee.Id)"></div>
                    i++;
                }
            }
        </div>
    }

    <div class="flex flex-row items-center gap-0.5 opacity-100 transition-opacity md:opacity-0 md:group-focus-within:opacity-100 md:group-hover:opacity-100">
        <button type="button" @ref=_assigneesTrigger class="material-symbols-rounded icon-button !text-lg leading-none" @onclick='() => AssigneesModal?.Open(_assigneesTrigger, Subtask, Members)' title="Add/remove assignees">person_add</button>
        <button type="button" id="subtask_edit_@Subtask.Id" class="material-symbols-rounded icon-button !text-lg leading-none" @onclick='() => EditSubtaskModal?.Open($"subtask_edit_{Subtask.Id}", Subtask)' title="Edit subtask">edit</button>
        <button type="button" class="material-symbols-rounded icon-button !text-lg leading-none hover:!text-red-button" @onclick="DeleteSubtask" title="Delete subtask">delete</button>
    </div>
</div>

@code {
    [CascadingParameter(Name = Constants.CascadingParameters.CurrentAccount)]
    private User _user { get; set; } = default!;

    [CascadingParameter(Name = Constants.CascadingParameters.MainLayout)]
    private MainLayout _mainLayout { get; set; } = default!;

    [Parameter]
    public required Subtask Subtask { get; set; }

    [Parameter]
    public EditSubtaskModal? EditSubtaskModal { get; set; }

    [Parameter]
    public List<User> Members { get; set; } = [];

    [Parameter]
    public EventCallback UpdateCard { get; set; }

    [Parameter]
    public AssigneesModal? AssigneesModal { get; set; }

    private ElementReference? _assigneesTrigger;

    private async Task OnSubtaskStatusChanged(ChangeEventArgs e)
    {
        try
        {
            await _cardService.SetSubtaskCompletedAsync(Subtask.Id, _user.Id, e.Value is bool completed && completed);
            await UpdateCard.InvokeAsync();
        }
        catch (Exception ex)
        {
            _logger?.LogError(ex, "Failed to change subtask status.");
            _mainLayout.RunNotification(new Notification("Failed to update subtask status.", NotificationType.Fail));
        }
    }

    private async Task DeleteSubtask()
    {
        try
        {
            await _cardService.DeleteSubtaskAsync(Subtask.Id, _user.Id);
            await UpdateCard.InvokeAsync();
        }
        catch (Exception ex)
        {
            _logger?.LogError(ex, "Failed to delete subtask.");
            _mainLayout.RunNotification(new Notification("Failed to delete subtask.", NotificationType.Fail));
        }
    }
}
