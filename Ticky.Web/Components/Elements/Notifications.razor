<div class="fixed inset-x-3 bottom-3 z-20 flex flex-col items-end gap-2 transition-all sm:inset-x-auto sm:right-5 sm:bottom-5 sm:gap-10">
    @foreach(var notification in _notifications) 
    {
        <div class="flex w-full max-w-full flex-row content-between items-stretch justify-between gap-2 overflow-hidden rounded-md bg-modal shadow transition-all sm:w-auto sm:gap-10">
            <div class="flex min-w-0 flex-row content-start items-stretch gap-3 sm:gap-5">
                <div class='@(notification.Type == NotificationType.Success ? "bg-green-500" : "bg-red-500") min-h-12 w-2 shrink-0 sm:min-h-16'>
                </div>
                <i class='@(notification.Type == NotificationType.Success ? "text-green-500 fa-circle-check" : "text-red-500 fa-circle-xmark") fa-regular self-center text-xl sm:text-2xl'></i>
                <label class="self-center py-2 text-xs sm:text-sm">
                    @notification.Text
                </label>
            </div>
            <div class="flex cursor-pointer items-center p-3 text-xs text-icon sm:p-5 sm:text-base transition-all hover:text-red-button" 
                @onclick="() => _notifications.Remove(notification)">
                CLOSE
            </div>
        </div>
    }
</div>

@code {
    private List<Notification> _notifications = [];

    public async void RunNotification(Notification notification)
    {
        _notifications.Add(notification);
        StateHasChanged();
        await Task.Delay(Constants.Limits.DEFAULT_NOTIFICATION_TIME_IN_MS);
        if(_notifications.Contains(notification)) {
            _notifications.Remove(notification);
            StateHasChanged();
        }
    }
}