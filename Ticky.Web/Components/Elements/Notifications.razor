<div class="fixed inset-x-3 bottom-3 z-20 flex flex-col items-end gap-2 transition-all sm:inset-x-auto sm:right-5 sm:bottom-5">
    @foreach(var notification in _notifications) 
    {
        var success = notification.Type == NotificationType.Success;
        <div role="status" class="flex w-full max-w-full flex-row items-center gap-3 rounded-xl border border-line bg-modal py-2 pr-2 pl-2.5 text-text shadow-lg shadow-black/10 transition-all sm:w-auto sm:min-w-72 sm:max-w-md dark:text-textDark">
            <div class='@(success ? "bg-green-500/15 text-green-600 dark:text-green-400" : "bg-red-500/15 text-red-600 dark:text-red-400") flex h-7 w-7 shrink-0 items-center justify-center rounded-full'>
                <span class="material-symbols-rounded block !text-lg !leading-none">@(success ? "check" : "priority_high")</span>
            </div>
            <span class="min-w-0 flex-1 text-sm font-medium">@notification.Text</span>
            <button type="button" title="Dismiss" class="flex h-7 w-7 shrink-0 items-center justify-center rounded-md text-subtext hover:bg-text/5 hover:text-text dark:text-subtextDark dark:hover:bg-textDark/10 dark:hover:text-textDark"
                @onclick="() => _notifications.Remove(notification)">
                <span class="material-symbols-rounded block !text-lg !leading-none">close</span>
            </button>
        </div>
    }
</div>

@code {
    private List<Notification> _notifications = [];

    public async void RunNotification(Notification notification)
    {
        _notifications.Add(notification);
        StateHasChanged();
        await Task.Delay(Constants.Limits.DEFAULT_NOTIFICATION_TIME_IN_MS);
        if(_notifications.Contains(notification)) {
            _notifications.Remove(notification);
            StateHasChanged();
        }
    }
}